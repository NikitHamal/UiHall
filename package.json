{
  "name": "uihall-workbench",
  "private": true,
  "version": "2.0.0",
  "description": "UiHall's static reference archive, local MCP tools and design skill",
  "scripts": {
    "dev": "node tools/serve.mjs",
    "build:corpus": "python3 tools/build_corpus.py",
    "audit": "python3 tools/audit_corpus.py --out docs/corpus-audit.json",
    "test": "npm test --prefix stormy-mcp && python3 tools/audit_corpus.py",
    "test:browser": "node tools/check_browser.mjs",
    "package:skill": "python3 tools/package_skill.py"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "playwright": "^1.64.1"
  }
}
